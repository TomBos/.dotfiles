#!/usr/bin/env bash
show_help() {
	local program_name="${0##*/}"	
	echo
	echo "Usage: $program_name <mandatory> [optional]"
	echo
	echo "Options: "
	echo " -h, --help	Show this help message"
	echo
}

check_dependencies() {
	local missing=0
	
	local dependencies=(
		cat	
	)
	
	for cmd in "${dependencies[@]}"; do
		if ! command -v "$cmd" >/dev/null 2>&1; then
			echo "Missing dependency: $cmd" >&2
			missing=1
		fi
	done
	
	(( missing )) && exit 1
}

main() {
	echo "template"
}

if [[ $# == 0 || "$1" == "-h" || "$1" == "--help" ]]; then 
	show_help
	exit 1
fi

main "$@"
