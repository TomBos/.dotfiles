#!/usr/bin/env bash
show_help() {
	local program_name="${0##*/}"	
	echo
	echo "Usage: $program_name <file.zip> [dir-name]"
	echo
	echo "Options: "
	echo " -h, --help	Show this help message"
	echo
}

main() {
	if ! command -v unzip >/dev/null 2>&1; then
		echo "Error: unzip is not installed." >&2
		exit 2
	fi
	
	if [[ "$1" != *.zip ]]; then
		echo "Error: '$1' is not a .zip file" >&2
		exit 3
	fi

	# Derivate dir name from the zip file	
	local dirname
	if [[ -n "$2" ]]; then
		dirname="$2"
	else
		dirname="${1%.zip}"
		dirname="${dirname// /-}"
	fi

	command unzip "$1" -d "$dirname"
}

if [[ $# == 0 || "$1" == "-h" || "$1" == "--help" ]]; then 
	show_help
	exit 1
fi

main "$@"

