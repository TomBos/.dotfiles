#!/usr/bin/env bash
show_banner() {
	echo "============================================="
	echo "Extract – CLI utility for extracting archives"
	echo "============================================="
}

show_help() {
	show_banner
	echo
	echo "Usage: extract <file.zip> [dir-name]"
}

extract_file () {
	if ! command -v unzip >/dev/null 2>&1; then
		echo "Error: unzip is not installed." >&2
		exit 1
	fi

	if [[ -z "$1" || "$1" == "-h" || "$1" == "--help" ]]; then 
		show_help
		return 2
	fi
	
	if [[ "$1" != *.zip ]]; then
		echo "Error: '$1' is not a .zip file" >&2
		return 3
	fi

	local dirname
	if [[ -n "$2" ]]; then
		dirname="$2"
	else
		dirname="${1%.zip}"
		dirname="${dirname// /-}"
	fi

	command unzip "$1" -d "$dirname"
}

extract_file "$@"

