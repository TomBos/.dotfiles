#!/usr/bin/env bash
function cd() {
	if [[ "$1" == //* ]]; then
		command cd ..
	else
		command cd "$@"
	fi
}

function stow() {
	if [[ "$(pwd)" != "$HOME/.dotfiles" ]]; then
		echo -e "\033[33m Stow was blocked to prevent creating misplaced symlinks  "
	else
		command stow "$@"
		bash "$XDG_CONFIG_HOME/git/generate-git-config"
	fi
}

function git-submodule-update() {
	git submodule update --remote --merge
}

function path() {
	local IFS=':'
	for p in $PATH; do
		echo "$p"
	done
}

function copy-branch() {
	git rev-parse --abbrev-ref HEAD | wl-copy
}

function record() {
	wf-recorder -g "$(slurp)" -f "$XDG_PICTURES_DIR/$(date +%Y-%m-%d_%H-%M-%S).mp4"
}

function screenshot() {
	local DIR="$XDG_PICTURES_DIR/$(date +%Y-%m-%d_%H-%M-%S).jpg"
	grim -g "$(slurp)" - | tee >(wl-copy) > "$DIR"
}

function mount-as-usb() {
	local USB_DIR="/mnt/usb"
	
	# Check if directory exists
	if [[ ! -d "$USB_DIR" ]]; then
		echo "$USB_DIR does not exist, exiting"
		return 1
	fi

	# Check if a device argument was provided
	if [[ -z "$1" ]]; then
		echo "Usage: mount-as-usb /dev/sdX1"
		return 1
	fi

	# Mount with UID/GID, show errors if it fails
	sudo mount -o uid=1000,gid=1000 "$1" "$USB_DIR" || {
		echo "Mount failed for $1"
		return 1
	}

	echo "$1 mounted to $USB_DIR"
}

function steam() {
	local count=0
	local max=4

	nohup steam > /dev/null 2>&1 &
	# Keep sleeping until "$HOME/.steampath" is not dangling symlink 
	while [[ ! -L "$HOME/.steampath" || -e "$HOME/.steampath" ]]; do
		((count++))	
		sleep 0.5
		if ((count >= max));then
			break
		fi
	done
	rm -f "$HOME/.steampath"
}

